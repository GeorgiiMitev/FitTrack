@model FitTrack.Models.WorkoutPlan
@{ ViewData["Title"] = Model.Name; }
<h1>@Model.Name</h1>
<p>Goal: @Model.Goal | Source: @(Model.IsAiGenerated ? "AI-generated" : "Manual") | Status: @(Model.IsActive ? "Active" : "Saved")</p>
@if (!string.IsNullOrWhiteSpace(TempData["WorkoutSaved"] as string)) { <p role="status">@TempData["WorkoutSaved"]</p> }
@if (!Model.IsActive) { <form asp-action="Activate" asp-route-id="@Model.Id" method="post"><button type="submit">Activate plan</button></form> }
else { <a class="btn btn-primary" asp-action="Complete" asp-route-id="@Model.Id">Log completed workout</a> }
@foreach (var day in Model.PlanExercises.OrderBy(item => item.DayOfTheWeek).GroupBy(item => item.DayOfTheWeek))
{
    <section class="mt-4"><h2>@((DayOfWeek)day.Key)</h2>
        <ul>@foreach (var exercise in day) { <li>@exercise.ExerciseName — @exercise.Sets sets × @exercise.Repetitions reps; rest @exercise.RestSeconds seconds</li> }</ul>
    </section>
}
<p><a asp-action="Index">Back to plans</a></p>
