@model FitTrack.Models.ProgressEntry
@{ ViewData["Title"] = "Add a measurement"; }
<header class="page-header"><div class="page-header-copy"><a class="back-link" asp-controller="Progress" asp-action="Index">← Progress</a><span class="eyebrow d-block mt-3">STRENGTH TRACKING</span><h1 class="mt-1">Add a measurement</h1><p>Track the heaviest completed set for a lift. Reuse an exercise name from your workout history to keep its trend together.</p></div></header>
<section class="app-card form-card"><form asp-action="Create" method="post" data-loading data-loading-label="Saving measurement…">
    <div asp-validation-summary="All" class="alert alert-danger measurement-validation-summary" role="alert"></div>
    <div class="mb-3"><label asp-for="ExerciseName" class="form-label">Exercise or lift</label><input asp-for="ExerciseName" class="form-control" list="exercise-suggestions" autocomplete="off" placeholder="e.g. Barbell squat" /><datalist id="exercise-suggestions">@foreach (var exercise in (IReadOnlyList<string>)(ViewBag.ExerciseSuggestions ?? new List<string>())) { <option value="@exercise"></option> }</datalist><div class="form-text">Choose a lift from your workout history or enter a name. Keep the name consistent between measurements.</div><span asp-validation-for="ExerciseName" class="field-validation-error small"></span></div>
    <div class="mb-3"><label asp-for="MaxWeight" class="form-label">Heaviest set completed</label><div class="input-group"><input asp-for="MaxWeight" class="form-control" min="0.1" max="1000" step="0.1" /><span class="input-group-text">kg</span></div><div class="form-text">Enter the external weight used for your heaviest completed set.</div><span asp-validation-for="MaxWeight" class="field-validation-error small"></span></div>
    <div class="mb-4"><label asp-for="Date" class="form-label">Measurement date</label><input asp-for="Date" class="form-control" type="date" max="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" /><span class="form-text">Only one measurement per lift per day; edit the saved entry if you need to correct it.</span><span asp-validation-for="Date" class="field-validation-error small"></span></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Save measurement</button><a class="btn btn-light" asp-controller="Progress" asp-action="Index">Cancel</a></div>
</form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
