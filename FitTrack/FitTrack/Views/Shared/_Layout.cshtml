@using System.Security.Claims
@{
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString();
    var activeAction = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string controller, string? action = null) =>
        string.Equals(activeController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(activeAction, action, StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f7fb" />
    <title>@ViewData["Title"] · FitTrack</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FitTrack.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header class="app-header">
    <nav class="navbar navbar-expand-lg app-navbar">
        <div class="container app-container">
            <a class="navbar-brand app-brand" asp-controller="Home" asp-action="Index" aria-label="FitTrack home">
                <span class="app-brand-mark" aria-hidden="true">F</span><span>FitTrack</span>
            </a>
            <button class="navbar-toggler app-nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#fittrack-navigation" aria-controls="fittrack-navigation" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="fittrack-navigation">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav app-nav-links me-auto">
                        <li class="nav-item"><a class="nav-link @Active("Home", "Index")" aria-current="@(Active("Home", "Index").Length > 0 ? "page" : null)" asp-controller="Home" asp-action="Index">Overview</a></li>
                        <li class="nav-item"><a class="nav-link @Active("WorkoutPlans")" aria-current="@(Active("WorkoutPlans").Length > 0 ? "page" : null)" asp-controller="WorkoutPlans" asp-action="Index">Plans</a></li>
                        <li class="nav-item"><a class="nav-link @Active("WorkoutLogs")" aria-current="@(Active("WorkoutLogs").Length > 0 ? "page" : null)" asp-controller="WorkoutLogs" asp-action="Index">History</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Progress")" aria-current="@(Active("Progress").Length > 0 ? "page" : null)" asp-controller="Progress" asp-action="Index">Progress</a></li>
                        <li class="nav-item"><a class="nav-link @Active("ExerciseLibrary")" aria-current="@(Active("ExerciseLibrary").Length > 0 ? "page" : null)" asp-controller="ExerciseLibrary" asp-action="Index">Exercises</a></li>
                    </ul>
                    <div class="dropdown app-account-menu">
                        <button class="btn app-account-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="app-avatar" aria-hidden="true">@((User.Identity.Name ?? "F")[0].ToString().ToUpperInvariant())</span>
                            <span class="app-account-name">@User.Identity.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end app-account-dropdown">
                            <li><span class="dropdown-header">Your account</span></li>
                            <li><a class="dropdown-item" asp-controller="UserProfiles" asp-action="Index">My profile</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item" type="submit">Log out</button></form></li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2 app-guest-links">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">Create account</a>
                    </div>
                }
            </div>
        </div>
    </nav>
</header>
<div class="container app-container">
    <main role="main" class="app-main">@RenderBody()</main>
</div>
@if (User.Identity?.IsAuthenticated == true)
{
    <aside id="fittrack-assistant" class="assistant-widget" aria-label="Fitness assistant">
        <button id="fittrack-assistant-launcher" type="button" class="btn btn-primary assistant-launcher" aria-expanded="false" aria-controls="fittrack-assistant-panel">
            <span class="assistant-launcher-mark" aria-hidden="true">✦</span><span>Ask your coach</span>
        </button>
        <section id="fittrack-assistant-panel" class="assistant-panel" hidden aria-labelledby="fittrack-assistant-heading">
            <div class="assistant-chat-header">
                <span class="assistant-chat-avatar" aria-hidden="true">✦</span>
                <div class="assistant-chat-heading"><h2 id="fittrack-assistant-heading" class="h6 mb-0">FitTrack coach</h2><span>Training guidance based on your progress</span></div>
                <button id="fittrack-assistant-close" type="button" class="btn-close" aria-label="Close chat"></button>
            </div>
            <div id="fittrack-assistant-messages" class="assistant-chat-messages" role="log" aria-label="Conversation with the FitTrack coach" aria-live="polite" aria-relevant="additions text"></div>
            <form id="fittrack-assistant-form" asp-controller="Coach" asp-action="Ask" method="post">
                @Html.AntiForgeryToken()
                <label class="visually-hidden" for="fittrack-assistant-question">Message the FitTrack coach</label>
                <div class="assistant-composer"><textarea id="fittrack-assistant-question" name="question" class="form-control" rows="1" maxlength="2000" placeholder="Write a message…" required></textarea><button id="fittrack-assistant-send" type="submit" class="btn btn-primary" aria-label="Send message"><span aria-hidden="true">↑</span></button></div>
                <div class="assistant-composer-hint">Enter to send · Shift + Enter for a new line</div>
            </form>
        </section>
    </aside>
}
<footer class="app-footer"><div class="container app-container d-flex flex-column flex-sm-row justify-content-between gap-2"><span>© @DateTime.Today.Year FitTrack</span><a asp-controller="Home" asp-action="Privacy">Privacy</a></div></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (User.Identity?.IsAuthenticated == true) { <script src="~/js/assistant.js" asp-append-version="true"></script> }
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
