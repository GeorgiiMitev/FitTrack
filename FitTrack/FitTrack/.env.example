# Copy this file to `.env` beside `appsettings.json`, then uncomment and set
# the key for the provider you want to use. Keep the other provider commented.
# Never commit `.env` or share your key.

# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Gemini (takes precedence if both keys are configured)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash
