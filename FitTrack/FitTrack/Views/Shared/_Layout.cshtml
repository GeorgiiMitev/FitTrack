@using System.Security.Claims
@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var useAppShell = isSignedIn && ViewData["UsePublicLayout"] as bool? != true;
    var displayName = User.Identity?.Name ?? "Athlete";
    var username = displayName.Contains('@') ? displayName[..displayName.IndexOf('@')] : displayName;
    if (!string.IsNullOrEmpty(username)) username = char.ToUpperInvariant(username[0]) + username[1..];
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (useAppShell)
    {
        <script>try { document.documentElement.dataset.theme = localStorage.getItem('fittrack-theme') === 'light' ? 'light' : 'dark'; } catch { document.documentElement.dataset.theme = 'dark'; }</script>
    }
    else
    {
        <script>document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';</script>
    }
    <title>@ViewData["Title"] - FitTrack</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/FitTrack.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(useAppShell ? "app-authenticated" : "app-public")">
<a class="skip-link" href="#main-content">Skip to main content</a>
@if (useAppShell)
{
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="brand-lockup" asp-controller="Home" asp-action="Dashboard" aria-label="FitTrack dashboard">
                <span class="brand-mark"><svg viewBox="0 0 28 28" aria-hidden="true"><path d="M4 15h4l3-8 5 14 3-8h5" /></svg></span>
                <span>FIT<span>TRACK</span></span>
            </a>
            <button id="mobile-nav-toggle" class="mobile-nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="app-navigation"><span aria-hidden="true">☰</span></button>
            <a class="sidebar-user" asp-controller="UserProfiles" asp-action="Index">
                @await Component.InvokeAsync("ProfileAvatar")
                <span class="sidebar-user-info"><strong>@username</strong><small>Fitness profile</small></span>
            </a>
            <p class="sidebar-section-label">MAIN MENU</p>
            <nav id="app-navigation" class="app-nav" aria-label="Main navigation">
                <a asp-controller="Home" asp-action="Dashboard" class="app-nav-link" aria-current="@(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg><span>Dashboard</span></a>
                <a asp-controller="ExerciseLibrary" asp-action="Index" class="app-nav-link" aria-current="@(currentController == "ExerciseLibrary" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9v6M3.5 10v4M18 9v6m2.5-5v4M6 12h12"/></svg><span>Exercise library</span></a>
                <a asp-controller="WorkoutPlans" asp-action="Index" class="app-nav-link" aria-current="@(currentController == "WorkoutPlans" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4.5h6M8.5 10h7m-7 4h7m-7 4h4"/></svg><span>Workout plans</span></a>
                <a asp-controller="WorkoutLogs" asp-action="Index" class="app-nav-link" aria-current="@(currentController == "WorkoutLogs" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5zM8 8h8M8 12h8m-8 4h5"/></svg><span>Workout history</span></a>
                <a asp-controller="Progress" asp-action="Index" class="app-nav-link" aria-current="@(currentController == "Progress" || currentController == "ProgressEntries" ? "page" : null)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5m0 14h17M7 15l4-4 3 2 6-7"/></svg><span>Analytics</span></a>
            </nav>
            <div class="sidebar-bottom">
                <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="sidebar-logout"><span aria-hidden="true">↗</span> Sign out</button></form>
                <div class="sidebar-footer"><span class="footer-pulse"></span> YOUR PERSONAL FITNESS SPACE</div>
            </div>
        </aside>
        <button id="mobile-nav-backdrop" class="mobile-nav-backdrop" type="button" aria-label="Close navigation menu" hidden></button>
        <div class="app-main-column">
            <header class="app-topbar">
                <div><span class="topbar-kicker">FITNESS SPACE</span><span class="topbar-date">@DateTime.Now.ToString("dddd, MMMM d")</span></div>
                <div class="topbar-actions">
                    <button id="theme-toggle" class="theme-switch" type="button" aria-label="Switch to light mode" aria-pressed="false" title="Switch to light mode">
                        <span class="theme-switch-track" aria-hidden="true"><span class="theme-switch-sun">☼</span><span class="theme-switch-moon">☾</span><span class="theme-switch-thumb"></span></span>
                    </button>
                </div>
            </header>
            <main id="main-content" role="main" class="app-page-content">@RenderBody()</main>
            <footer class="app-footer">FITTRACK <span>·</span> BUILT AROUND YOUR GOALS</footer>
        </div>
    </div>
}
else
{
    <header class="public-header">
        <a class="brand-lockup" asp-controller="Home" asp-action="Index" aria-label="FitTrack home"><span class="brand-mark"><svg viewBox="0 0 28 28" aria-hidden="true"><path d="M4 15h4l3-8 5 14 3-8h5" /></svg></span><span>FIT<span>TRACK</span></span></a>
        <nav aria-label="Account"><a asp-controller="Account" asp-action="Login">Sign in</a><a asp-controller="Account" asp-action="Register" class="btn btn-primary">Create account</a></nav>
    </header>
    <main id="main-content" role="main" class="public-main">@RenderBody()</main>
}
@if (useAppShell)
{
    <aside id="fittrack-assistant" class="assistant-widget" aria-label="Fitness assistant">
        <button id="fittrack-assistant-launcher" type="button" class="btn btn-primary assistant-launcher" aria-label="Ask your coach" aria-expanded="false" aria-controls="fittrack-assistant-panel">
            <span class="assistant-launcher-mark" aria-hidden="true">✦</span><span>Ask your coach</span>
        </button>
        <section id="fittrack-assistant-panel" class="assistant-panel" hidden aria-labelledby="fittrack-assistant-heading">
            <div class="assistant-chat-header">
                <span class="assistant-chat-avatar" aria-hidden="true">✦</span>
                <div class="assistant-chat-heading"><h2 id="fittrack-assistant-heading" class="h6 mb-0">FitTrack coach</h2><span>Training guidance based on your progress</span></div>
                <button id="fittrack-assistant-close" type="button" class="btn-close" aria-label="Close chat"></button>
            </div>
            <div id="fittrack-assistant-messages" class="assistant-chat-messages" role="log" aria-label="Conversation with the FitTrack coach" aria-live="polite" aria-relevant="additions text"></div>
            <form id="fittrack-assistant-form" asp-controller="Coach" asp-action="Ask" method="post">
                @Html.AntiForgeryToken()
                <label class="visually-hidden" for="fittrack-assistant-question">Message the FitTrack coach</label>
                <div class="assistant-composer"><textarea id="fittrack-assistant-question" name="question" class="form-control" rows="1" maxlength="2000" placeholder="Write a message…" required></textarea><button id="fittrack-assistant-send" type="submit" class="btn btn-primary" aria-label="Send message"><span aria-hidden="true">↑</span></button></div>
                <div class="assistant-composer-hint">AI requests may queue while another AI task runs · Enter to send · Shift + Enter for a new line</div>
            </form>
        </section>
    </aside>
    <dialog id="app-confirm-dialog" class="app-confirm-dialog" aria-labelledby="app-confirm-title" aria-describedby="app-confirm-message">
        <form method="dialog">
            <div class="app-confirm-heading"><span class="app-confirm-mark" aria-hidden="true">!</span><div><p class="eyebrow">PLEASE CONFIRM</p><h2 id="app-confirm-title">Delete this item?</h2></div></div>
            <p id="app-confirm-message" class="app-confirm-message"></p>
            <div class="app-confirm-actions"><button type="submit" class="btn btn-outline-secondary" value="cancel">Cancel</button><button type="submit" class="btn btn-danger" value="confirm" data-confirm-accept>Delete</button></div>
        </form>
    </dialog>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@if (useAppShell) { <script src="~/js/assistant.js" asp-append-version="true"></script> }
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
