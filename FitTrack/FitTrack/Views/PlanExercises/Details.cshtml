@model FitTrack.Models.PlanExercise
@{ ViewData["Title"] = Model.ExerciseName; }
<header class="page-header"><div class="page-header-copy"><a class="back-link" asp-controller="WorkoutPlans" asp-action="Details" asp-route-id="@Model.WorkoutPlanId">← @Model.WorkoutPlan?.Name</a><span class="eyebrow d-block mt-3">PLANNED EXERCISE · @((DayOfWeek)Model.DayOfTheWeek)</span><h1 class="mt-1">@Model.ExerciseName</h1><p>Prescription from your saved workout plan.</p></div></header>
<section class="app-card form-card"><dl class="details-list"><dt>Plan</dt><dd>@Model.WorkoutPlan?.Name</dd><dt>Training day</dt><dd>@((DayOfWeek)Model.DayOfTheWeek)</dd><dt>Sets</dt><dd>@Model.Sets</dd><dt>Repetitions per set</dt><dd>@Model.Repetitions</dd><dt>Rest between sets</dt><dd>@Model.RestSeconds seconds</dd></dl></section>
