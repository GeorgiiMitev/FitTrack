@model IEnumerable<FitTrack.Models.PlanExercise>
@{ var exercises = Model.ToList(); ViewData["Title"] = "Planned exercises"; }
<div class="plan-exercises-page">
<a class="back-link" asp-controller="WorkoutPlans" asp-action="Index">← Workout plans</a>
<header class="plan-exercises-heading"><div><p class="eyebrow">YOUR ROUTINE DETAILS</p><h1>Planned exercises</h1><p>Review each movement and its prescription across your saved plans.</p></div>@if (exercises.Count > 0) { <span class="plan-exercises-total"><strong>@exercises.Count</strong> planned movement@(exercises.Count == 1 ? "" : "s")</span> }</header>
@if (exercises.Count == 0)
{
    <div class="empty-state"><h2>No planned exercises yet</h2><p>Create a workout plan to see your exercise prescriptions here.</p><a class="btn btn-primary" asp-controller="WorkoutPlans" asp-action="Manual">Create a plan</a></div>
}
else
{
    <div class="data-table-panel planned-exercise-table"><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Exercise</th><th>Plan</th><th>Training day</th><th>Sets and reps</th><th>Rest</th><th><span class="visually-hidden">Details</span></th></tr></thead><tbody>
    @foreach (var exercise in exercises)
    {
        <tr><td><a class="planned-exercise-name" asp-action="Details" asp-route-id="@exercise.Id">@exercise.ExerciseName</a></td><td><a class="planned-exercise-plan" asp-controller="WorkoutPlans" asp-action="Details" asp-route-id="@exercise.WorkoutPlanId">@exercise.WorkoutPlan?.Name</a></td><td><span class="planned-day-badge">@((DayOfWeek)exercise.DayOfTheWeek)</span></td><td><span class="planned-prescription">@exercise.Sets <small>sets</small> <i>×</i> @exercise.Repetitions <small>reps</small></span></td><td><span class="planned-rest">@exercise.RestSeconds <small>sec</small></span></td><td><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@exercise.Id">Details</a></td></tr>
    }
    </tbody></table></div></div>
}
</div>
