@model FitTrack.Models.RegisterViewModel
@{ ViewData["Title"] = "Регистрация"; }
<div class="account-page">
    <section class="account-card">
        <h1>Регистрация</h1>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="UserName" class="form-label">Потребителско име</label><input asp-for="UserName" class="form-control" autocomplete="username" /><span asp-validation-for="UserName" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Email" class="form-label">Имейл</label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Password" class="form-label">Парола</label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Потвърди паролата</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary w-100">Създай акаунт</button>
        </form>
        <p class="text-center mt-3 mb-0">Вече имаш акаунт? <a asp-action="Login">Вход</a></p>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
