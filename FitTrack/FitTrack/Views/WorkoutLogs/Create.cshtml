@model FitTrack.Models.ManualWorkoutLogViewModel
@{ ViewData["Title"] = "Log an exercise"; }
<header class="page-header"><div class="page-header-copy"><a class="back-link" asp-action="Index">← Workout history</a><h1 class="mt-3">Log an exercise</h1><p>Record one exercise entry. For a full session, log a workout from an active plan.</p></div></header>
<section class="app-card form-card">
    <form asp-action="Create" method="post" data-loading data-loading-label="Saving…">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <div class="mb-3"><label asp-for="ExerciseName" class="form-label">Exercise</label><input asp-for="ExerciseName" class="form-control" placeholder="e.g. Push-up" autocomplete="off" /><span asp-validation-for="ExerciseName" class="field-validation-error small"></span></div>
        <div class="mb-3"><label asp-for="CompletedAt" class="form-label">Date and time</label><input asp-for="CompletedAt" type="datetime-local" class="form-control" /><span asp-validation-for="CompletedAt" class="field-validation-error small"></span></div>
        <div class="row g-3"><div class="col-6"><label asp-for="SetsCompleted" class="form-label">Sets</label><input asp-for="SetsCompleted" class="form-control" min="1" max="20" /><span asp-validation-for="SetsCompleted" class="field-validation-error small"></span></div><div class="col-6"><label asp-for="RepetitionsCompleted" class="form-label">Repetitions per set</label><input asp-for="RepetitionsCompleted" class="form-control" min="1" max="100" /><span asp-validation-for="RepetitionsCompleted" class="field-validation-error small"></span></div></div>
        <div class="mt-3 mb-3"><label asp-for="WeightUsed" class="form-label">External weight <span class="text-secondary fw-normal">(kg, optional)</span></label><input asp-for="WeightUsed" class="form-control" min="0" max="1000" step="0.1" /><span asp-validation-for="WeightUsed" class="field-validation-error small"></span><div class="form-text">Leave at 0 for bodyweight exercises.</div></div>
        <div class="mb-4"><label asp-for="Notes" class="form-label">Notes <span class="text-secondary fw-normal">(optional)</span></label><textarea asp-for="Notes" class="form-control" rows="3" maxlength="500" placeholder="How did it feel? Any details for next time?"></textarea><span asp-validation-for="Notes" class="field-validation-error small"></span></div>
        <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" type="submit">Save exercise</button><a class="btn btn-light" asp-action="Index">Cancel</a></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
