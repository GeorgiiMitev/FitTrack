@model FitTrack.Models.ProfileEditViewModel
@{ ViewData["Title"] = "Edit profile"; ViewData["FormAction"] = "Edit"; ViewData["SubmitLabel"] = "Save changes"; }
<h1>Edit profile</h1>
<img src="@(Model.CurrentPhotoPath ?? "/images/default-profile.svg")" alt="Profile photo" width="128" height="128" />
<partial name="_ProfileForm" model="Model" />
<a asp-action="Index">Cancel</a>
@section Styles { <link rel="stylesheet" href="~/css/profile-equipment.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
