@model FitTrack.Models.PlanExercise

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>PlanExercise</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
