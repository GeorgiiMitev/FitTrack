@{ ViewData["Title"] = "Welcome"; }
<section class="welcome-panel">
    <div class="welcome-card">
        <div class="welcome-mark" aria-hidden="true">F</div>
        <span class="eyebrow">YOUR TRAINING, IN ONE PLACE</span>
        <h1>Make room for progress.</h1>
        <p class="lead">Build a routine around your goals, equipment, and schedule. Keep your workouts and progress together, one session at a time.</p>
        <div class="d-flex flex-column flex-sm-row justify-content-center gap-2"><a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Create your account</a><a class="btn btn-outline-primary btn-lg" asp-controller="Account" asp-action="Login">Log in</a></div>
        <div class="welcome-points"><span>Plan with purpose</span><span>Keep a clear history</span><span>See your consistency</span></div>
    </div>
</section>
