@model IEnumerable<FitTrack.Models.WorkoutLog>
@{ ViewData["Title"] = "Workout history"; }
<h1>Workout history</h1>
<p><a asp-action="Create" class="btn btn-primary">Log an exercise</a> <a asp-controller="Progress" asp-action="Index">Progress calendar</a></p>
@if (!Model.Any()) { <p>No workouts recorded yet. Complete an active plan or add a workout.</p> }
<table class="table"><thead><tr><th>Date</th><th>Exercise</th><th>Plan</th><th>Sets × reps</th><th>Weight</th><th>Notes</th><th></th></tr></thead><tbody>
@foreach (var log in Model)
{
    <tr><td>@log.CompletedAt.ToLocalTime().ToString("g")</td><td>@log.ExerciseName</td><td>@(log.WorkoutPlan?.Name ?? "Manual workout")</td><td>@log.SetsCompleted × @log.RepetitionsCompleted</td><td>@log.WeightUsed kg</td><td>@log.Notes</td><td><a asp-action="Details" asp-route-id="@log.Id">Details</a><form asp-action="Delete" asp-route-id="@log.Id" method="post" class="d-inline"><button type="submit">Delete</button></form></td></tr>
}
</tbody></table>
