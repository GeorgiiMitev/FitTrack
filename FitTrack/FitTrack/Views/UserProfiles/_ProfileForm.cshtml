@model FitTrack.Models.ProfileEditViewModel
@{ var formAction = ViewData["FormAction"] as string ?? "Edit"; var submitLabel = ViewData["SubmitLabel"] as string ?? "Save"; }
@{ var equipmentGroups = (IReadOnlyDictionary<string, string[]>)ViewBag.EquipmentGroups; }
<form asp-action="@formAction" method="post" enctype="multipart/form-data" data-loading data-loading-label="Saving profile…">
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" autocomplete="name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Goal" class="form-label">Fitness goal</label>
        <select asp-for="Goal" class="form-select">
            @foreach (string goal in ViewBag.Goals) { <option value="@goal">@goal</option> }
        </select>
        <span asp-validation-for="Goal" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ExperienceLevel" class="form-label">Experience level</label>
        <select asp-for="ExperienceLevel" asp-items="Html.GetEnumSelectList<FitTrack.Models.FitnessExperienceLevel>()" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="SessionDurationMinutes" class="form-label">Preferred session duration (minutes)</label>
        <input asp-for="SessionDurationMinutes" class="form-control" type="number" min="15" max="240" />
        <span asp-validation-for="SessionDurationMinutes" class="text-danger"></span>
    </div>
    <fieldset class="mb-4">
        <legend>Preferred training days</legend>
        <p class="form-text mt-0">Choose the days you usually want to train.</p>
        <div class="profile-day-options">@foreach (string day in ViewBag.Weekdays)
        {
            <label class="profile-day-option"><input type="checkbox" name="PreferredTrainingDays" value="@day" checked="@(Model.PreferredTrainingDays.Contains(day) ? "checked" : null)" /><span>@day</span></label>
        }</div>
        <span asp-validation-for="PreferredTrainingDays" class="text-danger d-block"></span>
    </fieldset>
    <fieldset class="mb-3">
        <legend>Available equipment</legend>
        <p class="text-muted">Choose everything you can use. Select several options across categories.</p>
        <div class="profile-equipment-groups">
        @foreach (var group in equipmentGroups)
        {
            <section class="profile-equipment-group" aria-label="@group.Key">
                <h3>@group.Key</h3>
                <div class="profile-equipment-options">
                @foreach (string equipment in group.Value)
                {
                    <label class="profile-equipment-option">
                        <input type="checkbox" name="Equipment" value="@equipment" checked="@(Model.Equipment.Contains(equipment, StringComparer.OrdinalIgnoreCase) ? "checked" : null)" />
                        <span>@equipment</span>
                    </label>
                }
                </div>
            </section>
        }
        </div>
        <span asp-validation-for="Equipment" class="text-danger d-block"></span>
    </fieldset>
    <div class="mb-3">
        <label asp-for="ProfilePhoto" class="form-label">Profile photo (JPG, PNG, or WebP; up to 5 MB)</label>
        <input asp-for="ProfilePhoto" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" />
        <span asp-validation-for="ProfilePhoto" class="text-danger"></span>
    </div>
    <div class="profile-form-footer"><p class="small text-secondary mb-0">Your profile details stay editable at any time.</p><button type="submit" class="btn btn-primary">@submitLabel</button></div>
</form>
