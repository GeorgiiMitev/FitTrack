@model FitTrack.Models.ManualWorkoutLogViewModel
@{ ViewData["Title"] = "Log workout"; }
<h1>Log an exercise</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="ExerciseName"></label><input asp-for="ExerciseName" class="form-control" /><span asp-validation-for="ExerciseName" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="CompletedAt">Date and time</label><input asp-for="CompletedAt" type="datetime-local" class="form-control" /><span asp-validation-for="CompletedAt" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="SetsCompleted">Sets</label><input asp-for="SetsCompleted" class="form-control" min="1" max="20" /></div>
    <div class="mb-3"><label asp-for="RepetitionsCompleted">Repetitions</label><input asp-for="RepetitionsCompleted" class="form-control" min="1" max="100" /></div>
    <div class="mb-3"><label asp-for="WeightUsed">Weight (kg)</label><input asp-for="WeightUsed" class="form-control" min="0" max="1000" step="0.1" /></div>
    <div class="mb-3"><label asp-for="Notes"></label><textarea asp-for="Notes" class="form-control"></textarea></div>
    <button class="btn btn-primary" type="submit">Save workout</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
