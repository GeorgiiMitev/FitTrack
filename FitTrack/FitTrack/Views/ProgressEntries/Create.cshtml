@model FitTrack.Models.ProgressEntry
@{ ViewData["Title"] = "Add a measurement"; }
<header class="page-header"><div class="page-header-copy"><a class="back-link" asp-controller="Progress" asp-action="Index">← Progress</a><span class="eyebrow d-block mt-3">STRENGTH TRACKING</span><h1 class="mt-1">Add a measurement</h1><p>Record a max-weight measurement for one lift. Use the same lift name each time to see its trend.</p></div></header>
<section class="app-card form-card"><form asp-action="Create" method="post" data-loading data-loading-label="Saving measurement…">
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="ExerciseName" class="form-label">Exercise or lift</label><input asp-for="ExerciseName" class="form-control" placeholder="e.g. Barbell squat" /><span asp-validation-for="ExerciseName" class="field-validation-error small"></span></div>
    <div class="mb-3"><label asp-for="MaxWeight" class="form-label">Max weight lifted</label><div class="input-group"><input asp-for="MaxWeight" class="form-control" min="0.1" max="1000" step="0.1" /><span class="input-group-text">kg</span></div><span asp-validation-for="MaxWeight" class="field-validation-error small"></span></div>
    <div class="mb-4"><label asp-for="Date" class="form-label">Measurement date</label><input asp-for="Date" class="form-control" type="date" /><span asp-validation-for="Date" class="field-validation-error small"></span></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Save measurement</button><a class="btn btn-light" asp-controller="Progress" asp-action="Index">Cancel</a></div>
</form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
