@model FitTrack.Models.ProfileEditViewModel
@{ ViewData["Title"] = "My profile"; }
<h1>My profile</h1>
<img src="@(Model.CurrentPhotoPath ?? "/images/default-profile.svg")" alt="Profile photo" width="128" height="128" />
<dl class="row mt-3">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Goal</dt><dd class="col-sm-9">@Model.Goal</dd>
    <dt class="col-sm-3">Experience</dt><dd class="col-sm-9">@Model.ExperienceLevel</dd>
    <dt class="col-sm-3">Training days</dt><dd class="col-sm-9">@string.Join(", ", Model.PreferredTrainingDays)</dd>
    <dt class="col-sm-3">Session duration</dt><dd class="col-sm-9">@Model.SessionDurationMinutes minutes</dd>
    <dt class="col-sm-3">Equipment</dt><dd class="col-sm-9">@string.Join(", ", Model.Equipment)</dd>
</dl>
<p><a asp-action="Edit" class="btn btn-primary">Edit profile</a></p>
@if (TempData["ProfileSaved"] is string saved) { <p role="status">@saved</p> }
