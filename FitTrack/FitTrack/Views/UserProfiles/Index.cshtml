@model FitTrack.Models.ProfileEditViewModel
@{ ViewData["Title"] = "My profile"; var profileName = Model.Name; if (!string.IsNullOrEmpty(profileName)) profileName = char.ToUpperInvariant(profileName[0]) + profileName[1..]; }
<header class="page-heading-row profile-heading"><div><p class="eyebrow">YOUR STARTING POINT</p><h1>Fitness profile</h1><p class="page-subtitle">Your preferences help FitTrack tailor workouts and coaching suggestions.</p></div><a asp-action="Edit" class="btn btn-primary">Edit profile</a></header>
@if (TempData["ProfileSaved"] is string saved) { <div class="alert alert-success" role="status">@saved</div> }
<section class="profile-overview-card">
    <div class="profile-identity"><img class="profile-photo" src="@(Model.CurrentPhotoPath ?? "/images/default-profile.svg")" alt="Profile photo" onerror="this.onerror=null;this.src='/images/default-profile.svg';" /><div><p class="eyebrow">FITTRACK MEMBER</p><h2>@profileName</h2><span>@Model.ExperienceLevel experience</span></div></div>
    <div class="profile-facts-grid">
        <article><span>Current goal</span><strong>@Model.Goal</strong></article>
        <article><span>Session length</span><strong>@Model.SessionDurationMinutes min</strong></article>
        <article><span>Training days</span><strong>@(Model.PreferredTrainingDays.Count == 0 ? "Not set" : string.Join(", ", Model.PreferredTrainingDays))</strong></article>
    </div>
    <div class="profile-equipment-summary"><span class="eyebrow">AVAILABLE EQUIPMENT</span><div class="profile-tag-list">@foreach (var item in Model.Equipment) { <span>@item</span> }</div></div>
</section>
