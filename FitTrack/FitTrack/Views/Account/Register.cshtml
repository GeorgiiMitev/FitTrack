@model FitTrack.Models.RegisterViewModel
@{ ViewData["Title"] = "Create your account"; }
<section class="auth-layout auth-register" aria-labelledby="auth-heading">
    <section class="account-card auth-card">
        <div class="auth-mark" aria-hidden="true"><span>F</span>T</div>
        <p class="auth-card-kicker">A FRESH START</p>
        <h2 id="auth-heading">Create your account</h2>
        <p class="auth-card-description">A few details to get your personal fitness space ready.</p>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="auth-validation text-danger mb-3"></div>
            <div class="auth-field"><label asp-for="UserName" class="form-label">Username</label><input asp-for="UserName" class="form-control" autocomplete="username" placeholder="Choose a username" /><span asp-validation-for="UserName" class="text-danger"></span></div>
            <div class="auth-field"><label asp-for="Email" class="form-label">Email address</label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="auth-field"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Create a password" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <div class="auth-field"><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Enter it again" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
            <div class="auth-remember-row"><input asp-for="RememberMe" class="form-check-input auth-remember-input" /><label asp-for="RememberMe" class="form-check-label auth-remember-label">Remember me</label></div>
            <button type="submit" class="btn btn-primary auth-submit">Create account <span aria-hidden="true">↗</span></button>
        </form>
        <p class="auth-card-switch">Already have an account? <a asp-action="Login">Sign in</a></p>
        <div class="auth-secure-note"><span aria-hidden="true">◆</span> Your details are used to set up your fitness profile.</div>
    </section>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
