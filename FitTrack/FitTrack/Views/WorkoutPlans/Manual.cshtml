@model FitTrack.Models.ManualPlanViewModel
@{ ViewData["Title"] = "Create manual plan"; }
<header class="page-header"><div class="page-header-copy"><a class="back-link" asp-action="Index">← Workout plans</a><h1 class="mt-3">Create a workout plan</h1><p>Choose exercises that match your profile equipment. We’ll spread them across your preferred days.</p></div></header>
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-warning" role="status">@Model.Error</div> }
<form asp-action="Manual" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-8 col-lg-6"><label for="search" class="form-label">Find an exercise</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Search by name" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary" type="submit">Search</button> <a class="btn btn-link" asp-action="Manual">Clear</a></div>
</form>
<form asp-action="Manual" method="post" data-loading data-loading-label="Saving plan…">
    <input type="hidden" asp-for="Search" />
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    <section class="app-card form-card mb-4">
        <div class="mb-3"><label asp-for="PlanName" class="form-label">Plan name</label><input asp-for="PlanName" class="form-control" placeholder="e.g. Full-body foundation" /><span asp-validation-for="PlanName" class="field-validation-error small"></span></div>
        <div><label asp-for="Goal" class="form-label">Plan goal</label><input asp-for="Goal" class="form-control" /><span asp-validation-for="Goal" class="field-validation-error small"></span></div>
    </section>
    <div class="section-heading"><div><h2>Choose your exercises</h2><p>Select at least one movement. You can refine your list with search.</p></div><span class="selection-count" data-selection-count aria-live="polite">0 exercises selected</span></div>
    @if (Model.AvailableExercises.Count == 100) { <p class="text-secondary">Showing the first 100 matches. Search by name to narrow the list.</p> }
    @if (Model.AvailableExercises.Count == 0) { <p>No suitable exercises are available at the moment. Check the wger connection and equipment in your profile.</p> }
    <div class="row g-2">
    @for (var i = 0; i < Model.AvailableExercises.Count; i++)
    {
        var item = Model.AvailableExercises[i];
        <div class="col-12 col-lg-6"><div class="form-check border rounded p-3 h-100">
            <input class="form-check-input" type="checkbox" name="ExerciseIds" value="@item.Id" id="exercise-@item.Id" checked="@(Model.ExerciseIds.Contains(item.Id) ? "checked" : null)" />
            <label class="form-check-label fw-semibold" for="exercise-@item.Id">@item.Name</label>
            <div class="small text-secondary ms-4">@string.Join(", ", item.Muscles) · Equipment: @string.Join(", ", item.Equipment)</div>
        </div></div>
    }
    </div>
    <span asp-validation-for="ExerciseIds" class="text-danger"></span>
    <button class="btn btn-primary mt-3" type="submit">Save plan</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
