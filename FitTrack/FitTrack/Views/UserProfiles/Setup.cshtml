@model FitTrack.Models.ProfileEditViewModel
@{ ViewData["Title"] = "Set up your profile"; ViewData["FormAction"] = "Setup"; ViewData["SubmitLabel"] = "Save and continue"; }
<div class="setup-progress"><span class="setup-kicker">PROFILE SETUP</span><span>Step 1 of 1</span></div>
<header class="page-header"><div class="page-header-copy"><span class="eyebrow">A BETTER STARTING POINT</span><h1>Set up your fitness profile</h1><p>Tell us what you’re working toward and what you have available. You can change this later.</p></div></header>
<section class="app-card profile-form-card"><partial name="_ProfileForm" model="Model" /></section>
@section Styles { <link rel="stylesheet" href="~/css/profile-equipment.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
