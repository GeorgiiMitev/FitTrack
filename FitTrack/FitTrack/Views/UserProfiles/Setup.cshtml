<header class="page-heading-row"><div><p class="eyebrow">LET’S MAKE IT YOURS</p><h1>Set up your fitness profile</h1><p class="page-subtitle">These preferences personalize exercise suggestions and training plans. You can change them later.</p></div></header>
<section class="app-form-card profile-setup-card"><partial name="_ProfileForm" model="Model" /></section>
@section Styles { <link rel="stylesheet" href="~/css/profile-equipment.css" asp-append-version="true" /> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
