@model IEnumerable<FitTrack.Models.PlanExercise>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ExerciseName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkoutPlanId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkoutPlan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DayOfTheWeek)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sets)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Repetitions)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RestSeconds)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.ExerciseName)
            </td>
            <td>
                @Html.DisplayFor(model => item.WorkoutPlanId)
            </td>
            <td>
                @Html.DisplayFor(model => item.WorkoutPlan)
            </td>
            <td>
                @Html.DisplayFor(model => item.DayOfTheWeek)
            </td>
            <td>
                @Html.DisplayFor(model => item.Sets)
            </td>
            <td>
                @Html.DisplayFor(model => item.Repetitions)
            </td>
            <td>
                @Html.DisplayFor(model => item.RestSeconds)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
