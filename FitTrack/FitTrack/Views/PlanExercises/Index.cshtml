@model IEnumerable<FitTrack.Models.PlanExercise>
@{ ViewData["Title"] = "Planned exercises"; }
<h1>Planned exercises</h1>
<table class="table"><thead><tr><th>Plan</th><th>Day</th><th>Exercise</th><th>Sets</th><th>Reps</th><th>Rest (seconds)</th></tr></thead><tbody>
@foreach (var exercise in Model) { <tr><td><a asp-controller="WorkoutPlans" asp-action="Details" asp-route-id="@exercise.WorkoutPlanId">@exercise.WorkoutPlan?.Name</a></td><td>@((DayOfWeek)exercise.DayOfTheWeek)</td><td>@exercise.ExerciseName</td><td>@exercise.Sets</td><td>@exercise.Repetitions</td><td>@exercise.RestSeconds</td></tr> }
</tbody></table>
