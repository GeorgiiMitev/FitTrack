@model FitTrack.Models.WorkoutLog
@{ ViewData["Title"] = "Workout details"; }
<h1>@Model.ExerciseName</h1>
<dl class="row"><dt class="col-sm-3">Completed</dt><dd class="col-sm-9">@Model.CompletedAt.ToLocalTime().ToString("f")</dd><dt class="col-sm-3">Sets and repetitions</dt><dd class="col-sm-9">@Model.SetsCompleted × @Model.RepetitionsCompleted</dd><dt class="col-sm-3">Weight</dt><dd class="col-sm-9">@Model.WeightUsed kg</dd><dt class="col-sm-3">Plan</dt><dd class="col-sm-9">@(Model.WorkoutPlan?.Name ?? "Manual workout")</dd><dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd></dl>
<a asp-action="Index">Back to history</a>
