@model FitTrack.Models.WorkoutHistoryViewModel
@{ ViewData["Title"] = "Workout history"; var firstItem = Model.TotalItems == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1; var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalItems); }
<header class="page-header">
    <div class="page-header-copy"><span class="eyebrow">YOUR TRAINING RECORD</span><h1>Workout history</h1><p>Review your sessions and find a past workout when you need it.</p></div>
    <div class="page-actions"><a class="btn btn-primary" asp-action="Create">Log an exercise</a><a class="btn btn-outline-primary" asp-controller="Progress" asp-action="Index">Progress overview</a></div>
</header>
<form asp-action="Index" method="get" class="app-card history-filters mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4"><label class="form-label" for="search">Exercise or plan</label><input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Search your history" /></div>
        <div class="col-6 col-md-2"><label class="form-label" for="from">From</label><input class="form-control" id="from" name="from" type="date" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></div>
        <div class="col-6 col-md-2"><label class="form-label" for="to">To</label><input class="form-control" id="to" name="to" type="date" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></div>
        <div class="col-8 col-md-2"><label class="form-label" for="sort">Order</label><select class="form-select" id="sort" name="sort"><option value="newest" selected="@(Model.Sort == "newest" ? "selected" : null)">Newest first</option><option value="oldest" selected="@(Model.Sort == "oldest" ? "selected" : null)">Oldest first</option></select></div>
        <div class="col-4 col-md-2 d-flex gap-2"><button class="btn btn-primary flex-grow-1" type="submit">Apply</button><a class="btn btn-light" asp-action="Index" aria-label="Clear filters">Clear</a></div>
    </div>
</form>
<div class="d-flex justify-content-between align-items-center gap-2 mb-2"><p class="small text-secondary mb-0">@firstItem–@lastItem of @Model.TotalItems entries</p></div>
@if (Model.Logs.Count == 0)
{
    <div class="empty-state"><div class="empty-state-mark" aria-hidden="true">↗</div><h2>@(Model.TotalItems == 0 && string.IsNullOrEmpty(Model.Search) && Model.From is null && Model.To is null ? "No workouts logged yet" : "No workouts found")</h2><p>@(Model.TotalItems == 0 && string.IsNullOrEmpty(Model.Search) && Model.From is null && Model.To is null ? "Log an exercise here, or complete a workout from one of your active plans." : "Try a wider date range or a different search.")</p>@if (Model.TotalItems == 0 && string.IsNullOrEmpty(Model.Search) && Model.From is null && Model.To is null) { <a class="btn btn-primary" asp-action="Create">Log an exercise</a> }</div>
}
else
{
    <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Date</th><th>Exercise</th><th>Plan</th><th>Sets × reps</th><th>Weight</th><th>Notes</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
    @foreach (var log in Model.Logs)
    {
        <tr><td class="text-nowrap">@log.CompletedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")</td><td class="fw-semibold">@log.ExerciseName</td><td>@(log.WorkoutPlan?.Name ?? "Individual entry")</td><td>@log.SetsCompleted × @log.RepetitionsCompleted</td><td>@log.WeightUsed kg</td><td class="history-notes">@(string.IsNullOrWhiteSpace(log.Notes) ? "—" : log.Notes)</td><td><div class="table-actions"><a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@log.Id">Details</a><form asp-action="Delete" asp-route-id="@log.Id" method="post" data-confirm="Delete the @log.ExerciseName entry from your history?"><button type="submit" class="btn btn-sm btn-outline-danger">Delete</button></form></div></td></tr>
    }
    </tbody></table></div>
    @if (Model.PageCount > 1)
    {
        <nav class="mt-3" aria-label="Workout history pages"><ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page - 1)" aria-label="Previous page">Previous</a></li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.PageCount</span></li>
            <li class="page-item @(Model.Page == Model.PageCount ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-from="@Model.From" asp-route-to="@Model.To" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page + 1)" aria-label="Next page">Next</a></li>
        </ul></nav>
    }
}
